// SPDX-License-Identifier: GPL-2.0-or-later
//
// The icon and version information of PSPC's programs (included by pspc.rc and launcher.rc, which
// define PSPC_FILE_DESCRIPTION and PSPC_ORIGINAL_FILENAME first). pspc_version.h is generated from
// the version in CMakeLists.txt.
#include <winver.h>
#include "pspc_version.h"

1 ICON "pspc.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PSPC_VERSION_MAJOR, PSPC_VERSION_MINOR, PSPC_VERSION_PATCH, 0
 PRODUCTVERSION PSPC_VERSION_MAJOR, PSPC_VERSION_MINOR, PSPC_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "PSPC Project"
			VALUE "FileDescription", PSPC_FILE_DESCRIPTION
			VALUE "FileVersion", PSPC_VERSION
			VALUE "InternalName", PSPC_ORIGINAL_FILENAME
			VALUE "LegalCopyright", "PSPC Project, GNU General Public License v2 or later"
			VALUE "OriginalFilename", PSPC_ORIGINAL_FILENAME
			VALUE "ProductName", "PSPC"
			VALUE "ProductVersion", PSPC_VERSION
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
