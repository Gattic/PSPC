//
// VFPU instruction list, appended to ops.inc (same X-macro: OP(ID, "mnemonic", KIND)).
// One op per mnemonic family: semantics and disassembly read the .s/.p/.t/.q size from bits 7
// and 15 of the instruction word. Decoding is in vfpu_decode.cpp, semantics in vfpu_sem.h.

// COP2 (opcode 18): GPR <-> VFPU transfers and VFPU condition branches
OP(MFV, "mfv", ALU)
OP(MFVC, "mfvc", ALU)
