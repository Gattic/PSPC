# Copyrighted or user-supplied inputs: never commit.
/Games/
/private/
/reference/

# Build output
/build*/
/out/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe

# M33 plugins: user-supplied PRX files and the data they write; only the README is tracked.
/plugins/*
!/plugins/README.md

# Runtime data written by pspc
/ms0/
/cache/
*.log

# PSPC Network server databases (accounts, the ticket key): never commit
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Editors / tools
.vs/
.vscode/
__pycache__/
*.pyc

# Downloaded third-party binaries (fetched by tools/fetch_deps.ps1)
/third_party/
